header X-Slot {{ item.name }}
handle_path /api/* {
        reverse_proxy 127.0.0.1:{{ item.backend }} {
                health_uri /health
                health_interval 5s
                lb_try_duration 5s
        }
}
handle /openapi.json {
        reverse_proxy 127.0.0.1:{{ item.backend }}
}
handle {
        reverse_proxy 127.0.0.1:{{ item.frontend }}
}
