[Unit]
Description=Gym encrypted backup (PostgreSQL + uploads)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /opt/gym/devops/scripts/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
