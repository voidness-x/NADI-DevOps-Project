// Lets the deploy user start gym-backup.service (pre-deploy backup). Nothing else: no stop, no other unit.
polkit.addRule(function (action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      subject.user === "deploy" &&
      action.lookup("unit") === "gym-backup.service" &&
      action.lookup("verb") === "start") {
    return polkit.Result.YES;
  }
});
