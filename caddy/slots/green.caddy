# Managed by Caddy Slot Matrix - Green Environment
header X-Slot green

handle /openapi.json {
        reverse_proxy 127.0.0.1:8102
}

handle /auth/* {
        reverse_proxy 127.0.0.1:8102
}

handle_path /api/* {
        reverse_proxy 127.0.0.1:8102 {
                health_uri /health
                health_interval 5s
                lb_try_duration 5s
        }
}

handle {
        reverse_proxy 127.0.0.1:8202
}
