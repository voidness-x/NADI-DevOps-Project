# Global Caddy Options: Default SNI for IP/local handshakes
{
    default_sni nadi-gym.duckdns.org
}

# 1. Main App Ingress (Gateway Port 8001 -> Local Port 8000)
nadi-gym.duckdns.org:8000, :8000 {
    tls {
        dns duckdns REPLACE_WITH_DUCKDNS_TOKEN
    }

    import /etc/caddy/slots/active.caddy
}

# 2. Grafana Admin Ingress (Gateway Port 3001 -> Local Port 3000)
nadi-gym.duckdns.org:3000, :3000 {
    tls {
        dns duckdns REPLACE_WITH_DUCKDNS_TOKEN
    }

    reverse_proxy 127.0.0.1:3030
}
