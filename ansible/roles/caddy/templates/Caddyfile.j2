# Global Caddy Options: Default SNI for IP/local handshakes
{
    admin localhost:2019
    metrics
    default_sni {{ domain_name }}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

# 1. Main App Ingress (Gateway Port 8001 -> Local Port 8000)
{{ domain_name }}:{{ app_port }}, :{{ app_port }} {
    tls {
        dns duckdns {{ duckdns_token }}
    }
    encode zstd gzip
    import security_headers

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }

    import /etc/caddy/slots/active.caddy
}

# 2. Grafana Admin Ingress (Gateway Port 3001 -> Local Port 3000)
{{ domain_name }}:{{ admin_port }}, :{{ admin_port }} {
    tls {
        dns duckdns {{ duckdns_token }}
    }
    import security_headers
    reverse_proxy 127.0.0.1:3030
}
